# Mercora — E-commerce Operations with Cascade Integration
# Copy to backend/.env and fill in real values. Never commit real secrets.

# ============ API & SERVER ============
DEBUG=True
HOST=0.0.0.0
PORT=8001
API_TITLE=Mercora E-commerce Operations
API_VERSION=1.0.0

# ============ DATABASE - NEON POSTGRESQL ============
# Get from https://console.neon.tech
# Format: postgresql://user:password@host/database
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ============ AUTH (single admin account) ============
# Generate SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=replace_with_a_long_random_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change_this_password

# ============ CASCADE INTEGRATION ============
# Cascade consequence intelligence engine for simulation and risk assessment
CASCADE_API_URL=https://cascade-api-1097302968574.asia-south1.run.app
CASCADE_DEMO_USER=ops-ravi
CASCADE_TIMEOUT_SECONDS=30.0

# ============ FRONTEND ============
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ============ LOGGING ============
LOG_LEVEL=INFO
